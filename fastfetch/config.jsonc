{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // ── Atlas Ragnarok ───────────────────────────────────────────────────
    // Same palette as ghostty's `theme = Atlas Ragnarok`, which is built in:
    // /Applications/Ghostty.app/Contents/Resources/ghostty/themes/.
    // A black/white base with mint, three blues and one warm coral — the
    // theme has no yellow or true green, so the warm roles below all fold
    // into coral and the cool ones spread across the blues.
    //
    //   mint   99ffe4 = 38;2;153;255;228   coral  ff8080 = 38;2;153;255;228
    //   blue   3b82f6 = 38;2;153;255;228    sky    93c5fd = 38;2;147;197;253
    //   azure  60a5fa = 38;2;96;165;250    grey   a0a0a0 = 38;2;160;160;160
    //
    // Each section gets its own accent for its keys, the box frames sit back
    // in the neutral grey, and the section title takes the section accent.
    //
    // NOTE: the nvim colorscheme (~/.config/nvim/lua/config/hacktober.lua)
    // and the tide prompt (~/Code/dotfiles/fish/conf.d/tide.fish) are still
    // on Hacktober — this file no longer matches them.

    "display": {
        "percent": {
            "color": {
                "green": "38;2;153;255;228",
                "yellow": "38;2;96;165;250",
                "red": "38;2;153;255;228"
            }
        }
    },

    "logo": {
        // Was `"type": "kitty"` pointed at a text file, which silently fell
        // back to the built-in Apple logo — the ascii art never rendered.
        // "file" is the type for a text logo; height/width were image-only
        // options and did nothing here.
        "source": "~/.config/fastfetch/ascii.txt",
        "type": "file",
        "color": { "1": "38;2;153;255;228" }, // mint, applied to the whole logo
        "padding": {
            "top": 2,
            "left": 3
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;160;160;160m┌────────────────────────────────────────────────────┐"
        },
        {
            "type": "host",
            "key": " PC",
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "cpu",
            "key": "│ ├",
            "showPeCoreCount": true,
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛",
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "memory",
            "key": "│ ├󰍛",
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "disk",
            "key": "└ └",
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "kernel",
            "key": "│ ├",
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖",
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "shell",
            "key": "└ └",
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;160;160;160m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;160;160;160m┌────────────────────\u001b[38;2;153;255;228mUptime / Age\u001b[38;2;160;160;160m────────────────────┐"
        },
        {
            // Was `stat -c %W /`, which is GNU syntax: BSD stat rejects `-c`,
            // so $birth_install was empty and this printed days-since-1970
            // (~20700). `stat -f %B` is the BSD spelling. /var/db/.AppleSetupDone
            // is the first-boot marker — `/` only reports the last OS update,
            // because an APFS update re-creates the root snapshot.
            "type": "command",
            "key": "  OS Age ",
            "keyColor": "38;2;153;255;228",
            "text": "birth=$(stat -f %B /var/db/.AppleSetupDone 2>/dev/null || stat -f %B /); echo $(( ( $(date +%s) - birth ) / 86400 )) days"
        },
        {
            "type": "uptime",
            "key": "  Uptime ",
            "keyColor": "38;2;153;255;228"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;160;160;160m└────────────────────────────────────────────────────┘"
        },
        "break"
    ]
}
